# ============================================================
# TITAN AI — Muhit sozlamalari (NAMUNA)
# ============================================================
# Bu faylni nusxalab, ".env" nomi bilan saqlang va real qiymatlarni yozing:
#   Windows:  copy .env.example .env
# .env fayli GitHub'ga TUSHMAYDI (.gitignore bilan bloklangan).
# ============================================================

# --- MetaTrader 5 (DEMO account) ---
MT5_LOGIN=12345678
MT5_PASSWORD=your_demo_password
MT5_SERVER=Exness-MT5Trial
MT5_PATH=C:/Program Files/MetaTrader 5/terminal64.exe

# --- AI (OpenAI-mos provayder: Groq / Gemini / xAI ...) ---
# Groq (bepul, tavsiya):  base=https://api.groq.com/openai/v1  model=llama-3.3-70b-versatile
# Gemini (bepul):         base=https://generativelanguage.googleapis.com/v1beta/openai  model=gemini-2.0-flash
# xAI Grok (pullik):      base=https://api.x.ai/v1  model=grok-4
GROK_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
GROK_API_BASE=https://api.groq.com/openai/v1
GROK_MODEL=llama-3.3-70b-versatile

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHANNEL_ID=-1001234567890
TELEGRAM_ADMIN_IDS=123456789

# --- Savdo sozlamalari ---
TRADING_MODE=demo            # demo | live  (hozircha faqat demo!)
DEFAULT_RISK_PERCENT=1.0     # har savdoda kapitalning necha % risk
MAX_LOT=1.0                  # XAVFSIZLIK: maksimal lot (yaqin SL'da ulkan lotdan himoya)
MAX_DAILY_TRADES=5
DEFAULT_SYMBOLS=EURUSD,XAUUSD,GBPUSD,USDJPY,USDCHF,AUDUSD

# --- Real-time skaner ---
SCAN_INTERVAL=60             # necha soniyada bir marta skanlash
SIGNAL_COOLDOWN_MIN=30       # bir simvol qayta signal bermaslik oralig'i (daqiqa)
SCAN_TIMEFRAMES=M5,M15,H1    # skanlanadigan taymfrejmlar
AUTO_TRADE=false             # true bo'lsa signal kelishi bilan tugmasiz avtomatik savdo (ehtiyot!)
MIN_SL_ATR_RATIO=0.6         # SIFAT FILTRI: SL kamida shu marta o'rtacha shamdan uzoq bo'lsin (yaqin SL=sifatsiz)

# --- Pozitsiya monitoringi (trailing / break-even) ---
POSITION_MANAGE=true         # ochiq savdolarni avtomatik boshqarish
MONITOR_INTERVAL=15          # necha soniyada tekshirish
BREAK_EVEN_PROGRESS=0.4      # TP tomon 40% yursa SL entry'ga (zararsizlik)
TRAIL_START_PROGRESS=0.5     # 50% dan keyin trailing boshlanadi
TRAIL_LOCK=0.5               # harakatning 50% ini qulflaydi

# --- TradingView webhook (alohida xizmat: tvhook konteyneri) ---
# Maxfiy so'z: TradingView alert JSON'iga "secret":"..." qo'shasiz (yoki ?token=...).
# BO'SH bo'lsa xizmat HAR QANDAY so'rovni rad etadi (fail-closed, xavfsizlik).
# Uzun tasodifiy satr yozing, masalan:  openssl rand -hex 24
TV_WEBHOOK_SECRET=
TV_WEBHOOK_PORT=8080                  # ichki port (Caddy reverse-proxy orqasida)
TV_WEBHOOK_CHANNEL_ID=                # bo'sh = TELEGRAM_CHANNEL_ID ishlatiladi
# TradingView webhook faqat 80/443 portlarda ishlaydi — HTTPS uchun domen kerak.
# Caddy avtomatik Let's Encrypt sertifikat oladi (domen shu serverga qaragan bo'lsa):
WEBHOOK_DOMAIN=                       # masalan: hook.sizningdomen.uz

# --- Umumiy ---
TIMEZONE=Asia/Tashkent
LOG_LEVEL=INFO
