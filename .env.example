# ============================================================
# TITAN AI — Muhit sozlamalari (NAMUNA)
# ============================================================
# Bu faylni nusxalab, ".env" nomi bilan saqlang va real qiymatlarni yozing:
#   Windows:  copy .env.example .env
# .env fayli GitHub'ga TUSHMAYDI (.gitignore bilan bloklangan).
# ============================================================

# --- MetaTrader 5 (DEMO account) ---
MT5_LOGIN=12345678
MT5_PASSWORD=your_demo_password
MT5_SERVER=Exness-MT5Trial
MT5_PATH=C:/Program Files/MetaTrader 5/terminal64.exe

# --- Grok (xAI) API ---
GROK_API_KEY=xai-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROK_API_BASE=https://api.x.ai/v1
GROK_MODEL=grok-4

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHANNEL_ID=-1001234567890
TELEGRAM_ADMIN_IDS=123456789

# --- Savdo sozlamalari ---
TRADING_MODE=demo            # demo | live  (hozircha faqat demo!)
DEFAULT_RISK_PERCENT=1.0     # har savdoda kapitalning necha % risk
MAX_LOT=1.0                  # XAVFSIZLIK: maksimal lot (yaqin SL'da ulkan lotdan himoya)
MAX_DAILY_TRADES=5
DEFAULT_SYMBOLS=EURUSD,XAUUSD,GBPUSD,USDJPY,USDCHF,AUDUSD

# --- Real-time skaner ---
SCAN_INTERVAL=60             # necha soniyada bir marta skanlash
SIGNAL_COOLDOWN_MIN=30       # bir simvol qayta signal bermaslik oralig'i (daqiqa)
SCAN_TIMEFRAMES=M5,M15,H1    # skanlanadigan taymfrejmlar
AUTO_TRADE=false             # true bo'lsa signal kelishi bilan tugmasiz avtomatik savdo (ehtiyot!)

# --- Umumiy ---
TIMEZONE=Asia/Tashkent
LOG_LEVEL=INFO
