# ============================================================
# TITAN AI — Docker/VPS muhit sozlamalari (NAMUNA)
#   cp .env.example .env  va real qiymatlarni SIZ kiritasiz.
# ============================================================

# --- VNC (mt5 konteyneriga brauzerdan kirish; faqat SSH tunnel orqali) ---
VNC_USER=trader
VNC_PASSWORD=CHANGE_ME_strong_vnc_password

# --- MetaTrader 5 (DEMO account) — SIZ kiritasiz, Claude EMAS ---
MT5_LOGIN=12345678
MT5_PASSWORD=your_demo_password
MT5_SERVER=MetaQuotes-Demo
# DIQQAT: Docker'да MT5_PATH BO'SH qoldiriladi (Windows yo'li yo'q — Wine ichida ishlaydi)
MT5_PATH=

# --- AI (OpenAI-mos provayder: Groq bepul tavsiya) ---
GROK_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
GROK_API_BASE=https://api.groq.com/openai/v1
GROK_MODEL=llama-3.3-70b-versatile

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHANNEL_ID=-1001234567890
TELEGRAM_ADMIN_IDS=123456789

# --- Savdo sozlamalari (DEMO forward-test) ---
TRADING_MODE=demo
DEFAULT_RISK_PERCENT=0.5
MAX_LOT=1.0
MAX_DAILY_TRADES=5
DEFAULT_SYMBOLS=EURUSD,USDJPY,USDCHF

# --- Real-time skaner (signal/ta'lim rejimi — ko'proq signal) ---
# Eslatma: past TF (M5/M15) da spread har savdoni ko'proq yeydi -> sifat pastroq
# (edge yo'q, docs/EDGE_ANALYSIS.md). Faqat DEMO/signal/o'quv uchun.
# Kamroq lekin "sifatliroq" signal xohlasangiz: SCAN_TIMEFRAMES=H4, COOLDOWN=240.
SCAN_INTERVAL=60
SIGNAL_COOLDOWN_MIN=15
SCAN_TIMEFRAMES=M5,M15
AUTO_TRADE=false
MIN_SL_ATR_RATIO=0.6
# Bitta skan shu soniyada javob bermasa = MT5 ko'prigi muzlagan -> jarayon qayta ishga tushadi (Docker restart)
SCAN_HARD_TIMEOUT=90
# Signal natijasini kuzatish (TP1/TP2/TP3/SL follow-up grafik bilan)
SIGNAL_TRACKING=true
OUTCOME_INTERVAL=30

# --- Pozitsiya monitoringi ---
POSITION_MANAGE=true
MONITOR_INTERVAL=30
BREAK_EVEN_PROGRESS=0.4
TRAIL_START_PROGRESS=0.5
TRAIL_LOCK=0.5

# --- Bilim bazasi (RAG, A variant — signal izohини boyitadi, ta'lim) ---
# knowledge/ papkасидаги darslar semantik topilib Groq izohига qo'shiladi.
# YOQISHDАН OLDIN: knowledge/ ga fayl qo'shing + `docker exec mt5bot python -m app.knowledge.ingest`.
# KB signal SIFATINI o'zgartirmaydi (faqat izoh/ta'lim) — docs/EDGE_ANALYSIS.md.
KB_ENABLED=false
KB_EMBED_MODEL=BAAI/bge-small-en-v1.5
KB_TOP_K=3
KB_MIN_SCORE=0.3

# --- Umumiy ---
TIMEZONE=Asia/Tashkent
LOG_LEVEL=INFO
