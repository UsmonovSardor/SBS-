//@version=6
// ═══════════════════════════════════════════════════════════════════════════
//  GOLD BREAKOUT v5 — Session Range Breakout (TradingView Pine port)
//  ScalperBot_Breakout_v5.mq5 va breakout_backtest.py bilan AYNAN bir mantiq.
//
//  Mantiq: server-vaqti 00:00–08:00 M15 diapazon (Hi/Lo) → 08:00–20:00 breakout.
//    c[1] > Hi + 0.20*ATR  → BUY  (SL = Lo − buffer)
//    c[1] < Lo − 0.20*ATR  → SELL (SL = Hi + buffer)
//    TP = risk * 1.5.  MinRange 1.0*ATR, MaxRange 10*ATR. Kuniga 1 buy + 1 sell,
//    bir vaqtda 1 pozitsiya. Kirish keyingi bar ochilishida (realistik).
//
//  MUHIM (halol): TradingView XAUUSD datasi BIRJA vaqt zonasida keladi; brokeringiz
//    "server vaqti" (UTC+3) bilan mos kelishi uchun pastdagi Timezone ni to'g'rilang.
//    Aks holda diapazon oynasi soatlari siljib, natija MT5 dan farq qiladi.
// ═══════════════════════════════════════════════════════════════════════════

strategy("Gold Breakout v5",
     overlay          = true,
     initial_capital  = 10000,
     default_qty_type = strategy.fixed,
     default_qty_value= 1,
     pyramiding       = 0,
     slippage         = 15,                    // ~15 point slippage (gold)
     commission_type  = strategy.commission.cash_per_order,
     commission_value = 0.20,                  // spread taxmini (round-trip ~0.40$)
     calc_on_every_tick = false,
     process_orders_on_close = false)          // buyruq keyingi bar OCHILISHIDA bajariladi

// ── Inputs (EA bilan bir xil) ───────────────────────────────────────────────
grpS = "=== Sessiya (server vaqti) ==="
tz              = input.string("GMT+3", "Timezone (broker server)", group=grpS, tooltip="MT5 server vaqti. Buni XAUUSD grafigi soatlariga qarab moslang.")
RangeStartHour  = input.int(0,  "Diapazon START soat", group=grpS)
RangeEndHour    = input.int(8,  "Diapazon END soat",   group=grpS)
TradeStartHour  = input.int(8,  "Savdo START soat",    group=grpS)
TradeEndHour    = input.int(20, "Savdo END soat",      group=grpS)

grpB = "=== Breakout mantiq ==="
BufferATR   = input.float(0.20, "Buffer (ATR ulushi)",  step=0.05, group=grpB)
RR          = input.float(1.5,  "RR (TP = risk * RR)",  step=0.1,  group=grpB)
MinRangeATR = input.float(1.0,  "Min diapazon (ATR)",   step=0.1,  group=grpB)
MaxRangeATR = input.float(10.0, "Max diapazon (ATR, 0=off)", step=0.5, group=grpB)
ATRPeriod   = input.int(14,     "ATR davri", group=grpB)

grpT = "=== Ixtiyoriy trend filtri ==="
UseTrend    = input.bool(false, "Faqat HTF trend yo'nalishida", group=grpT)
TrendTF     = input.timeframe("60", "Trend TF", group=grpT)
TrendEMA    = input.int(200,   "Trend EMA davri", group=grpT)

grpX = "=== Xatti-harakat ==="
CloseAtEnd  = input.bool(false, "Sessiya oxirida yopish (Python replika = true, EA = false)", group=grpX, tooltip="EA pozitsiyani SL/TP gacha ushlaydi (false). Python backtest kun oxirida yopadi (true).")
ShowLines   = input.bool(true,  "Entry/SL/TP chiziqlarini chiz", group=grpX)

// ── Indikatorlar ────────────────────────────────────────────────────────────
atrVal   = ta.atr(ATRPeriod)
htfEma   = request.security(syminfo.tickerid, TrendTF, ta.ema(close, TrendEMA)[1], lookahead=barmerge.lookahead_off)

// ── Vaqt / sessiya ──────────────────────────────────────────────────────────
h        = hour(time, tz)
inRange  = h >= RangeStartHour and h < RangeEndHour
inTrade  = TradeStartHour <= TradeEndHour ? (h >= TradeStartHour and h < TradeEndHour) : (h >= TradeStartHour or h < TradeEndHour)

// ── Kunlik holat ────────────────────────────────────────────────────────────
var float rHi         = na
var float rLo         = na
var bool  boughtToday = false
var bool  soldToday   = false
var int   curDay      = na

dnow = year(time, tz) * 1000 + dayofyear(time, tz)
if dnow != curDay
    curDay      := dnow
    rHi         := na
    rLo         := na
    boughtToday := false
    soldToday   := false

if inRange
    rHi := na(rHi) ? high : math.max(rHi, high)
    rLo := na(rLo) ? low  : math.min(rLo, low)

// ── Filtrlar ────────────────────────────────────────────────────────────────
rangeSize = rHi - rLo
rangeReady = not na(rHi) and not na(rLo) and atrVal > 0
minOK  = rangeReady and rangeSize >= MinRangeATR * atrVal
maxOK  = MaxRangeATR <= 0 or (rangeReady and rangeSize <= MaxRangeATR * atrVal)
buffer = BufferATR * atrVal

flat      = strategy.position_size == 0
trendUp   = not UseTrend or close > htfEma
trendDn   = not UseTrend or close < htfEma
canTrade  = inTrade and rangeReady and minOK and maxOK and flat and barstate.isconfirmed

// ── Signal (yopilgan bar close bo'yicha; kirish keyingi bar ochilishida) ─────
longSig  = canTrade and not boughtToday and close > rHi + buffer and trendUp
shortSig = canTrade and not soldToday   and close < rLo - buffer and trendDn

// ── Chiziqlar (vizual) ──────────────────────────────────────────────────────
var line  lnEntry = na
var line  lnSL    = na
var line  lnTP    = na
var label lbl     = na

drawLines(float e, float sl, float tp, bool isLong) =>
    if ShowLines
        line.delete(lnEntry), line.delete(lnSL), line.delete(lnTP), label.delete(lbl)
        x1 = bar_index, x2 = bar_index + 30
        lnEntry := line.new(x1, e,  x2, e,  color=color.new(color.blue, 0),  width=2, style=line.style_dashed)
        lnSL    := line.new(x1, sl, x2, sl, color=color.new(color.red, 0),   width=1, style=line.style_dashed)
        lnTP    := line.new(x1, tp, x2, tp, color=color.new(color.green, 0), width=1, style=line.style_dashed)
        lbl     := label.new(x1, e, (isLong?"BUY":"SELL")+"  R:R 1:"+str.tostring(RR,"#.#"),
                             style=isLong?label.style_label_up:label.style_label_down,
                             color=isLong?color.new(color.green,20):color.new(color.red,20),
                             textcolor=color.white, size=size.small)

// ── Entry / Exit + Alert ────────────────────────────────────────────────────
if longSig
    sl   = rLo - buffer
    risk = close - sl
    tp   = close + risk * RR
    if risk > 0
        strategy.entry("Long", strategy.long)
        strategy.exit("Long-x", "Long", stop=sl, limit=tp)
        boughtToday := true
        drawLines(close, sl, tp, true)
        alert('{"symbol":"'+syminfo.ticker+'","tf":"'+timeframe.period+'","side":"BUY","entry":'+str.tostring(close)+',"sl":'+str.tostring(sl)+',"tp":'+str.tostring(tp)+'}', alert.freq_once_per_bar_close)

if shortSig
    sl   = rHi + buffer
    risk = sl - close
    tp   = close - risk * RR
    if risk > 0
        strategy.entry("Short", strategy.short)
        strategy.exit("Short-x", "Short", stop=sl, limit=tp)
        soldToday := true
        drawLines(close, sl, tp, false)
        alert('{"symbol":"'+syminfo.ticker+'","tf":"'+timeframe.period+'","side":"SELL","entry":'+str.tostring(close)+',"sl":'+str.tostring(sl)+',"tp":'+str.tostring(tp)+'}', alert.freq_once_per_bar_close)

// ── Sessiya oxirida yopish (Python replika bilan solishtirish uchun) ─────────
if CloseAtEnd and not inTrade and strategy.position_size != 0
    strategy.close_all(comment="Session end")

// ── Diapazon oynasini vizual ko'rsatish ─────────────────────────────────────
bgcolor(inRange ? color.new(color.gray, 90) : na, title="Diapazon oynasi")
plot(rangeReady and inTrade ? rHi : na, "Range Hi", color.new(color.teal, 0), style=plot.style_linebr)
plot(rangeReady and inTrade ? rLo : na, "Range Lo", color.new(color.orange, 0), style=plot.style_linebr)
